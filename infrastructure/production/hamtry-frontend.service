[Unit]
Description=Hamtry frontend and shared theme server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hamtry
Group=hamtry
EnvironmentFile=/etc/hamtry/hamtry.env
Environment=HAMTRY_PYTHON=/opt/hamtry/liveness/.venv/bin/python
Environment=DEEPFACE_HOME=/var/lib/hamtry/liveness
Environment=LIVENESS_PORT=8001
WorkingDirectory=/opt/hamtry/frontend/current
ExecStart=/opt/hamtry/runtime/node/bin/node /opt/hamtry/frontend/current/server/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
TimeoutStartSec=12min
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hamtry/theme /var/lib/hamtry/liveness
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
